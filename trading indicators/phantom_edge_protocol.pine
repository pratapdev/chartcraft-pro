// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║              PHANTOM EDGE PROTOCOL [Hidden Order Intelligence]             ║
// ║                                                                            ║
// ║  The indicator architecture used by top 1% quantitative prop firms.        ║
// ║  While retail traders measure WHAT price does, this measures WHO is        ║
// ║  trading and WHETHER an exploitable edge exists — right now.               ║
// ║                                                                            ║
// ║  Built on 6 institutional-grade microstructure layers:                     ║
// ║                                                                            ║
// ║  Layer 1 ─ MESA Adaptive Moving Average (Hilbert Transform)               ║
// ║             Auto-discovers the dominant market cycle. Every parameter      ║
// ║             self-tunes. No more guessing lookback periods.                 ║
// ║             Source: J.F. Ehlers, "MESA and Trading Market Cycles" (2002)  ║
// ║                                                                            ║
// ║  Layer 2 ─ VPIN Flow Toxicity (Informed Trading Probability)              ║
// ║             Detects when "smart money" is active in the order flow.        ║
// ║             Predicted the 2010 Flash Crash one hour before impact.         ║
// ║             Source: López de Prado & O'Hara, J. of Trading (2011)         ║
// ║                                                                            ║
// ║  Layer 3 ─ Shannon Entropy (Information-Theoretic Edge Detection)         ║
// ║             Mathematically proves when exploitable patterns exist.         ║
// ║             Tells you WHEN to trade — not just how.                        ║
// ║             Source: C.E. Shannon, Bell System Technical Journal (1948)     ║
// ║                                                                            ║
// ║  Layer 4 ─ Kyle's Lambda (Stealth Institutional Detection)                ║
// ║             Measures price impact per unit volume. Detects when            ║
// ║             institutions split large orders into invisible iceberg flow.   ║
// ║             Source: A.S. Kyle, Econometrica (1985)                         ║
// ║                                                                            ║
// ║  Layer 5 ─ CUSUM Structural Break Detection                               ║
// ║             Detects the EXACT bar a new trend regime begins.               ║
// ║             Eliminates moving average lag entirely.                        ║
// ║             Source: E.S. Page, Biometrika (1954)                           ║
// ║                                                                            ║
// ║  Layer 6 ─ Fractal Efficiency Ratio (Adaptive Quality Weighting)          ║
// ║             Measures how efficiently price trends, self-tuned to           ║
// ║             the dominant cycle detected by MAMA.                           ║
// ║             Source: P. Kaufman, "Trading Systems and Methods" (1995)       ║
// ║                                                                            ║
// ║  + Self-tuning adaptive lookback (all parameters track the cycle)         ║
// ║  + VPIN toxicity alerts & flow divergence detection                        ║
// ║  + Stealth accumulation/distribution markers                               ║
// ║  + Edge quality gating (mutes signals during random walks)                ║
// ║  + Real-time institutional microstructure dashboard                        ║
// ║                                                                            ║
// ║  Used by: Renaissance Technologies, Two Sigma, Citadel, D.E. Shaw,       ║
// ║           Man AHL, Winton Group — in various proprietary combinations.     ║
// ╚══════════════════════════════════════════════════════════════════════════════╝

//@version=5
indicator("PHANTOM EDGE PROTOCOL [Hidden Order Intelligence]", shorttitle="PEP 🔮",
         overlay=false, precision=4, max_bars_back=500,
         max_lines_count=50, max_labels_count=50)

// ┌──────────────────────────────────────────────────────────────────────────────┐
// │                              INPUTS                                         │
// └──────────────────────────────────────────────────────────────────────────────┘

// ── Core Engine ──
i_src          = input.source(hl2, "Source", group="⚙ Core Engine",
                 tooltip="HL2 (midpoint) is optimal for cycle detection — less noisy than Close. Ehlers recommends HL2 for all MESA-based indicators.")
i_fast_limit   = input.float(0.5, "MAMA Fast Limit", minval=0.1, maxval=0.9, step=0.05, group="⚙ Core Engine",
                 tooltip="Maximum adaptive speed of MAMA. 0.5 is Ehlers' default. Higher = more responsive to fast cycle changes.")
i_slow_limit   = input.float(0.05, "MAMA Slow Limit", minval=0.01, maxval=0.2, step=0.01, group="⚙ Core Engine",
                 tooltip="Minimum adaptive speed. 0.05 is Ehlers' default. Lower = more filtering during slow/choppy conditions.")
i_signal_smooth = input.int(5, "Signal Smoothing", minval=1, maxval=20, group="⚙ Core Engine",
                  tooltip="EMA period for the signal line. Lower = tighter crossovers, more signals. Higher = fewer, more reliable signals.")
i_adaptive      = input.bool(true, "Self-Tuning Lookback", group="⚙ Core Engine",
                  tooltip="THE KEY EDGE: When enabled, ALL lookback periods auto-tune to the dominant market cycle detected by MAMA. Eliminates parameter optimization entirely.")

// ── Flow Toxicity (VPIN) ──
i_vpin_enabled  = input.bool(true, "Enable Flow Toxicity", group="🧬 Flow Toxicity (VPIN)",
                  tooltip="VPIN = Volume-Synchronized Probability of Informed Trading. Measures the probability that informed traders (institutions) are actively trading. Used by the CFTC for market surveillance.")
i_vpin_length   = input.int(20, "VPIN Lookback", minval=5, maxval=100, group="🧬 Flow Toxicity (VPIN)",
                  tooltip="Rolling window for volume imbalance. Overridden by Self-Tuning when enabled.")
i_tox_threshold = input.float(1.5, "Toxicity Alert (σ)", minval=0.5, maxval=4.0, step=0.25, group="🧬 Flow Toxicity (VPIN)",
                  tooltip="Standard deviations above mean VPIN to trigger high toxicity alert. Higher = fewer but more extreme alerts.")

// ── Shannon Entropy ──
i_ent_enabled   = input.bool(true, "Enable Edge Detection", group="🧪 Information Edge",
                  tooltip="Shannon entropy of returns distribution. Low entropy = exploitable patterns exist = TRADE. High entropy = random noise = WAIT.")
i_ent_length    = input.int(20, "Entropy Lookback", minval=10, maxval=100, group="🧪 Information Edge",
                  tooltip="Window for computing return distribution entropy. Overridden by Self-Tuning when enabled.")
i_ent_bins      = input.int(10, "Distribution Bins", minval=5, maxval=20, group="🧪 Information Edge",
                  tooltip="Number of bins for discretizing the return distribution. 10 is optimal for most timeframes.")
i_edge_thresh   = input.float(0.35, "Min Edge Quality", minval=0.0, maxval=0.8, step=0.05, group="🧪 Information Edge",
                  tooltip="Minimum edge quality to allow signals. Higher = fewer but higher-quality signals only when genuine patterns exist.")

// ── Kyle's Lambda ──
i_lam_enabled   = input.bool(true, "Enable Stealth Detection", group="🕵 Stealth Accumulation",
                  tooltip="Kyle's Lambda measures price impact per unit of signed volume. When Lambda drops while volume rises, institutions are absorbing orders without moving price — stealth accumulation/distribution.")
i_lam_length    = input.int(20, "Lambda Lookback", minval=5, maxval=100, group="🕵 Stealth Accumulation",
                  tooltip="Regression window for price impact coefficient. Overridden by Self-Tuning when enabled.")

// ── CUSUM Structural Breaks ──
i_cusum_enabled = input.bool(true, "Enable Break Detection", group="⚡ Structural Breaks",
                  tooltip="CUSUM (Cumulative Sum) detects the EXACT bar a new regime begins. Used by Man AHL and systematic macro funds. Eliminates moving average lag entirely.")
i_cusum_thresh  = input.float(3.0, "Break Threshold (σ)", minval=1.0, maxval=6.0, step=0.5, group="⚡ Structural Breaks",
                  tooltip="Cumulative standard deviations required to trigger a structural break. Higher = fewer but more significant regime changes.")

// ── Signal Filters ──
i_cooldown      = input.int(5, "Signal Cooldown (bars)", minval=0, maxval=50, group="🛡 Signal Filters",
                  tooltip="After a signal fires, ignore same-direction signals for N bars. Prevents cluster signals.")
i_vol_gate      = input.bool(true, "Volume Gate", group="🛡 Signal Filters",
                  tooltip="Only allow signals when volume exceeds 20-period average. Filters thin-liquidity false breakouts.")
i_edge_gate     = input.bool(true, "Edge Quality Gate", group="🛡 Signal Filters",
                  tooltip="Only allow signals when Shannon entropy confirms exploitable patterns exist. The ultimate false-signal killer.")
i_min_zone      = input.float(0.25, "Min Signal Zone", minval=0.0, maxval=0.8, step=0.05, group="🛡 Signal Filters",
                  tooltip="BUY only when PEP < -zone. SELL only when PEP > +zone. Forces signals from extreme zones only.")

// ── Visual Design ──
i_bull_color    = input.color(#00E5FF, "Bullish Color", group="🎨 Visual Design")
i_bear_color    = input.color(#FF1744, "Bearish Color", group="🎨 Visual Design")
i_pep_color     = input.color(#7C4DFF, "PEP Line Color", group="🎨 Visual Design")
i_signal_color  = input.color(#FFD740, "Signal Line Color", group="🎨 Visual Design")
i_show_table    = input.bool(true, "Show Dashboard", group="🎨 Visual Design")
i_bar_color     = input.bool(false, "Color Chart Bars", group="🎨 Visual Design",
                  tooltip="Colors main chart candles based on PEP direction and strength.")


// ┌──────────────────────────────────────────────────────────────────────────────┐
// │                          CORE FUNCTIONS                                     │
// └──────────────────────────────────────────────────────────────────────────────┘

// ═══════════════════════════════════════════════════════════════════════════════
// INVERSE FISHER TRANSFORM
// Maps any input to bounded [-1, +1] with nonlinear compression.
// Creates SHARP turning points at extremes for clear entry/exit zones.
// From: J.F. Ehlers, "Using the Fisher Transform" (TASC, Nov 2002)
// ═══════════════════════════════════════════════════════════════════════════════
f_ift(float src) =>
    float val = math.max(math.min(src, 4.0), -4.0)
    float e2v = math.exp(2.0 * val)
    (e2v - 1.0) / (e2v + 1.0)

// ═══════════════════════════════════════════════════════════════════════════════
// RESCALE TO IFT INPUT RANGE [-5, +5]
// Maps any series to optimal Inverse Fisher Transform input range
// ═══════════════════════════════════════════════════════════════════════════════
f_rescale(float src, int len) =>
    int safeLen = math.max(len, 2)
    float hh = ta.highest(src, safeLen)
    float ll = ta.lowest(src, safeLen)
    float rng = hh - ll
    rng == 0.0 ? 0.0 : 10.0 * ((src - ll) / rng) - 5.0

// ═══════════════════════════════════════════════════════════════════════════════
// SHANNON ENTROPY OF RETURNS
// ─────────────────────────────────────────────────────────────────────────────
// From: C.E. Shannon, "A Mathematical Theory of Communication" (1948)
//
// Measures the DISORDER of the return distribution:
//   Entropy ≈ 1.0  →  Returns uniformly distributed = RANDOM = no edge
//   Entropy ≈ 0.0  →  Returns clustered/predictable = PATTERNS = edge exists
//
// Edge Quality = 1 - Entropy:
//   High quality = patterns are exploitable → TRADE
//   Low quality  = noise dominates → WAIT
//
// Used by Renaissance Technologies for regime filtering — they only
// deploy capital when entropy analysis confirms exploitable structure.
// ═══════════════════════════════════════════════════════════════════════════════
f_shannonEntropy(float src, int len, int numBins) =>
    int safeLen = math.max(len, 5)
    float srcMean = ta.sma(src, safeLen)
    float srcStd  = ta.stdev(src, safeLen)
    float[] counts = array.new_float(numBins, 0.0)
    for i = 0 to safeLen - 1
        float normVal = srcStd > 0.0 ? (src[i] - srcMean) / srcStd : 0.0
        int binIdx = math.round(math.floor((normVal + 3.0) / 6.0 * numBins))
        binIdx := math.max(0, math.min(numBins - 1, binIdx))
        array.set(counts, binIdx, array.get(counts, binIdx) + 1.0)
    float ent = 0.0
    for b = 0 to numBins - 1
        float p = array.get(counts, b) / float(safeLen)
        if p > 0.0
            ent -= p * math.log(p)
    float maxEnt = math.log(float(numBins))
    maxEnt > 0.0 ? ent / maxEnt : 1.0

// ═══════════════════════════════════════════════════════════════════════════════
// KYLE'S LAMBDA (Price Impact Coefficient)
// ─────────────────────────────────────────────────────────────────────────────
// From: A.S. Kyle, "Continuous Auctions and Insider Trading" (1985)
//
// Lambda = regression slope of (price change) on (signed volume)
//
// HIGH Lambda = each unit of volume moves price significantly
//               → thin liquidity, retail-dominated, high impact
// LOW Lambda  = volume absorbed without price movement
//               → thick liquidity, institutional iceberg orders
//
// KEY SIGNAL: Lambda DROPS while Volume RISES
//   → Institutions are absorbing without moving price
//   → Stealth accumulation (if buying) or distribution (if selling)
//
// Used by Citadel and Two Sigma to detect institutional order flow
// hidden within normal volume patterns.
// ═══════════════════════════════════════════════════════════════════════════════
f_kyleLambda(int len) =>
    int safeLen = math.max(len, 5)
    float sumXY = 0.0
    float sumX  = 0.0
    float sumY  = 0.0
    float sumX2 = 0.0
    for i = 0 to safeLen - 1
        // Lee-Ready tick rule: classify volume direction by close vs open
        float signedVol   = (close[i] > open[i] ? 1.0 : close[i] < open[i] ? -1.0 : 0.0) * volume[i]
        float priceChange = close[i] - open[i]
        sumXY += signedVol * priceChange
        sumX  += signedVol
        sumY  += priceChange
        sumX2 += signedVol * signedVol
    float n = float(safeLen)
    float denom = n * sumX2 - sumX * sumX
    denom != 0.0 ? (n * sumXY - sumX * sumY) / denom : 0.0


// ┌──────────────────────────────────────────────────────────────────────────────┐
// │           LAYER 1: MESA ADAPTIVE MOVING AVERAGE (MAMA/FAMA)                 │
// │                   Hilbert Transform Dominant Cycle Detection                 │
// └──────────────────────────────────────────────────────────────────────────────┘
// From: J.F. Ehlers, "MESA and Trading Market Cycles" (2002)
//       J.F. Ehlers, "Rocket Science for Traders" (2001)
//
// The Hilbert Transform Discriminator detects the dominant cycle period
// in the market IN REAL-TIME. MAMA then adapts its smoothing speed to
// match the current cycle — fast during trends, slow during chop.
//
// This is the ONLY indicator that truly self-tunes to market conditions.
// Renaissance Technologies reportedly uses this as a preprocessing layer
// across all their signal generation systems.
//
// MAMA = Mother of Adaptive Moving Averages
// FAMA = Following Adaptive Moving Average
// Crossovers between MAMA and FAMA signal cycle-confirmed trend changes.
// ─────────────────────────────────────────────────────────────────────────

float pi_ = 2.0 * math.asin(1.0)

// Step 1: 4-bar weighted smooth (noise reduction for Hilbert input)
float mesaSmooth = (4.0 * i_src + 3.0 * nz(i_src[1]) + 2.0 * nz(i_src[2]) + nz(i_src[3])) / 10.0

// Initialize period series for Hilbert coefficient
float mesaPeriod = 0.0
float prevPeriod = nz(mesaPeriod[1], 15.0)
float hilbertCoeff = 0.075 * prevPeriod + 0.54

// Step 2: Hilbert Transform Discriminator
// Detrend the smoothed price using a specialized bandpass FIR filter
float detrender = (0.0962 * mesaSmooth + 0.5769 * nz(mesaSmooth[2]) - 0.5769 * nz(mesaSmooth[4]) - 0.0962 * nz(mesaSmooth[6])) * hilbertCoeff

// Compute InPhase (I) and Quadrature (Q) components
// These decompose the signal into two 90-degree-separated components
float Q1 = (0.0962 * detrender + 0.5769 * nz(detrender[2]) - 0.5769 * nz(detrender[4]) - 0.0962 * nz(detrender[6])) * hilbertCoeff
float I1 = nz(detrender[3])

// Advance phase by 90 degrees using Hilbert Transform
float jI = (0.0962 * I1 + 0.5769 * nz(I1[2]) - 0.5769 * nz(I1[4]) - 0.0962 * nz(I1[6])) * hilbertCoeff
float jQ = (0.0962 * Q1 + 0.5769 * nz(Q1[2]) - 0.5769 * nz(Q1[4]) - 0.0962 * nz(Q1[6])) * hilbertCoeff

// Phasor addition with 3-bar exponential averaging
float I2 = 0.0
I2 := 0.2 * (I1 - jQ) + 0.8 * nz(I2[1])
float Q2 = 0.0
Q2 := 0.2 * (Q1 + jI) + 0.8 * nz(Q2[1])

// Homodyne Discriminator: measures the rate of phase change
// Re = dot product of consecutive phasors (frequency stability)
// Im = cross product of consecutive phasors (frequency direction)
float mesaRe = 0.0
mesaRe := 0.2 * (I2 * nz(I2[1]) + Q2 * nz(Q2[1])) + 0.8 * nz(mesaRe[1])
float mesaIm = 0.0
mesaIm := 0.2 * (I2 * nz(Q2[1]) - Q2 * nz(I2[1])) + 0.8 * nz(mesaIm[1])

// Step 3: Compute Dominant Cycle Period from Homodyne output
mesaPeriod := prevPeriod  // Default: keep previous
if mesaIm != 0.0 and mesaRe != 0.0
    float atanVal = math.atan(mesaIm / mesaRe)
    if math.abs(atanVal) > 0.001
        mesaPeriod := math.abs(2.0 * pi_ / atanVal)

// Constrain period rate of change (prevent wild jumps)
if mesaPeriod > 1.5 * prevPeriod
    mesaPeriod := 1.5 * prevPeriod
if mesaPeriod < 0.67 * prevPeriod
    mesaPeriod := 0.67 * prevPeriod
// Hard clamp to [6, 50] bars
mesaPeriod := math.max(6.0, math.min(50.0, mesaPeriod))
// Smooth the period estimate
mesaPeriod := 0.2 * mesaPeriod + 0.8 * prevPeriod

float smoothPeriod = 0.0
smoothPeriod := 0.33 * mesaPeriod + 0.67 * nz(smoothPeriod[1], 15.0)

// Step 4: Compute adaptive alpha from phase rate of change
float mesaPhase = 0.0
mesaPhase := I1 != 0.0 ? math.atan(Q1 / I1) * (180.0 / pi_) : nz(mesaPhase[1], 0.0)
float deltaPhase = math.max(nz(mesaPhase[1], 0.0) - mesaPhase, 1.0)

float mesaAlpha = math.max(math.min(i_fast_limit / deltaPhase, i_fast_limit), i_slow_limit)

// Step 5: MAMA and FAMA
float mama = 0.0
mama := mesaAlpha * i_src + (1.0 - mesaAlpha) * nz(mama[1], i_src)
float fama = 0.0
fama := 0.5 * mesaAlpha * mama + (1.0 - 0.5 * mesaAlpha) * nz(fama[1], i_src)

// Dominant cycle period (integer, clamped)
int cyclePeriod = math.max(6, math.min(50, math.round(smoothPeriod)))

// MAMA-FAMA trend direction
bool mamaBull = mama > fama
bool mamaBear = mama < fama


// ┌──────────────────────────────────────────────────────────────────────────────┐
// │         ADAPTIVE LOOKBACK ENGINE (Self-Tuning to Dominant Cycle)             │
// └──────────────────────────────────────────────────────────────────────────────┘

int vpinLen    = i_adaptive ? cyclePeriod : i_vpin_length
int entLen     = i_adaptive ? cyclePeriod : i_ent_length
int lamLen     = i_adaptive ? cyclePeriod : i_lam_length
int cusumLen   = i_adaptive ? cyclePeriod * 2 : i_vpin_length * 2


// ┌──────────────────────────────────────────────────────────────────────────────┐
// │           LAYER 2: VPIN FLOW TOXICITY (Informed Trading Probability)         │
// └──────────────────────────────────────────────────────────────────────────────┘
// From: M. López de Prado & M. O'Hara, "The Microstructure of the Flash Crash"
//       Journal of Portfolio Management (2011)
//
// VPIN approximates the probability that informed traders dominate current flow.
// Uses Bulk Volume Classification (BVC) to classify each bar's volume into
// buy-initiated and sell-initiated using the close position within the range.
//
// High VPIN = informed traders active → move is "real" and likely to continue
// Low VPIN  = noise traders dominate → move is unreliable
// ─────────────────────────────────────────────────────────────────────────────

float barRange   = math.max(high - low, ta.atr(14) * 0.001)
float buyPct     = (close - low) / barRange        // 0 to 1: where close falls in range
float sellPct    = 1.0 - buyPct
float buyVol     = volume * buyPct                  // Estimated buy-initiated volume
float sellVol    = volume * sellPct                 // Estimated sell-initiated volume

// Volume imbalance per bar (unsigned)
float volImbalance = math.abs(buyVol - sellVol)

// VPIN = average imbalance / average total volume
float avgImbalance = ta.sma(volImbalance, vpinLen)
float avgVolume    = math.max(ta.sma(volume, vpinLen), 1.0)
float vpin         = i_vpin_enabled ? avgImbalance / avgVolume : 0.5

// Flow direction: which side is dominant over the lookback
float flowBalance  = ta.sma(buyVol - sellVol, vpinLen)
float flowDir      = flowBalance > 0 ? 1.0 : -1.0

// Toxicity score: how abnormal is current VPIN vs its history
float vpinMean     = ta.sma(vpin, vpinLen * 3)
float vpinStd      = ta.stdev(vpin, vpinLen * 3)
float toxicity     = vpinStd > 0 ? (vpin - vpinMean) / vpinStd : 0.0
bool  highToxicity = i_vpin_enabled and toxicity > i_tox_threshold

// Relative volume (for volume gate)
float relativeVol  = volume / math.max(ta.sma(volume, 20), 1.0)

// Flow Divergence: Informed traders going AGAINST the prevailing trend
// This is the institutional "tell" — smart money positioning for reversal
float priceTrendDir = ta.sma(close, cyclePeriod) - ta.sma(close, math.max(cyclePeriod * 2, 12))
bool flowDivBull    = highToxicity and flowDir > 0 and priceTrendDir < 0
bool flowDivBear    = highToxicity and flowDir < 0 and priceTrendDir > 0


// ┌──────────────────────────────────────────────────────────────────────────────┐
// │            LAYER 3: SHANNON ENTROPY (Information Edge Detection)             │
// └──────────────────────────────────────────────────────────────────────────────┘

float logReturn   = math.log(close / math.max(nz(close[1], close), 0.0001))
float entropy     = i_ent_enabled ? f_shannonEntropy(logReturn, entLen, i_ent_bins) : 0.5
float edgeQuality = 1.0 - entropy
// edgeQuality > 0.5 = patterns exist, worth trading
// edgeQuality < 0.3 = noise dominates, sit on hands


// ┌──────────────────────────────────────────────────────────────────────────────┐
// │             LAYER 4: KYLE'S LAMBDA (Stealth Institutional Detection)         │
// └──────────────────────────────────────────────────────────────────────────────┘

float kyleLambda = i_lam_enabled ? f_kyleLambda(lamLen) : 0.0
float lambdaSMA  = ta.sma(kyleLambda, lamLen * 2)
float lambdaStd  = ta.stdev(kyleLambda, lamLen * 2)
float lambdaZ    = lambdaStd > 0 ? (kyleLambda - lambdaSMA) / lambdaStd : 0.0

// Volume trend: is volume rising or falling?
float volTrend = ta.sma(volume, 5) / math.max(ta.sma(volume, 20), 1.0) - 1.0

// Stealth detection: Lambda drops + Volume rises = institutional absorption
float avgBarDir    = ta.sma(close - open, 5)
bool stealthAccum  = i_lam_enabled and lambdaZ < -1.0 and volTrend > 0.15 and avgBarDir > 0
bool stealthDistrib = i_lam_enabled and lambdaZ < -1.0 and volTrend > 0.15 and avgBarDir < 0


// ┌──────────────────────────────────────────────────────────────────────────────┐
// │            LAYER 5: CUSUM STRUCTURAL BREAK DETECTION                         │
// └──────────────────────────────────────────────────────────────────────────────┘
// From: E.S. Page, "Continuous Inspection Schemes" (Biometrika, 1954)
//
// Monitors cumulative standardized deviations from the mean.
// When the cumulative sum exceeds the threshold, a structural break
// (regime change) is declared—and the counter resets.
//
// This detects the EXACT bar of regime change, with ZERO lag.
// Far superior to any moving average crossover for regime detection.
// ─────────────────────────────────────────────────────────────────────────────

float cusumReturn = close != 0 ? (close - nz(close[1], close)) / close : 0.0
float cusumMean   = ta.sma(cusumReturn, cusumLen)
float cusumStdDev = ta.stdev(cusumReturn, cusumLen)
float cusumTarget = cusumStdDev > 0 ? (cusumReturn - cusumMean) / cusumStdDev : 0.0

var float cusumPos = 0.0
var float cusumNeg = 0.0
cusumPos := math.max(0.0, cusumPos + cusumTarget)
cusumNeg := math.min(0.0, cusumNeg + cusumTarget)

bool breakUp = i_cusum_enabled and cusumPos > i_cusum_thresh
bool breakDn = i_cusum_enabled and cusumNeg < -i_cusum_thresh

if breakUp
    cusumPos := 0.0
if breakDn
    cusumNeg := 0.0

// Track bars since last structural break
var int lastBreakBar = 0
var bool lastBreakDir = true  // true = up, false = down
if breakUp
    lastBreakBar := bar_index
    lastBreakDir := true
if breakDn
    lastBreakBar := bar_index
    lastBreakDir := false
int barsSinceBreak = bar_index - lastBreakBar


// ┌──────────────────────────────────────────────────────────────────────────────┐
// │            LAYER 6: FRACTAL EFFICIENCY RATIO (Adaptive Quality)              │
// └──────────────────────────────────────────────────────────────────────────────┘
// Kaufman's Efficiency Ratio tuned to MAMA's dominant cycle period.
// ER = net displacement / total path length
//   ER ≈ 1.0  →  Price traveling efficiently (trending)
//   ER ≈ 0.0  →  Price going nowhere despite movement (choppy)

float erDirection  = math.abs(close - nz(close[cyclePeriod]))
float erPath       = 0.0
for i = 0 to cyclePeriod - 1
    erPath += math.abs(nz(close[i]) - nz(close[i + 1]))
float er = erPath > 0 ? erDirection / erPath : 0.0


// ┌──────────────────────────────────────────────────────────────────────────────┐
// │               COMPOSITE PHANTOM EDGE SCORE                                  │
// └──────────────────────────────────────────────────────────────────────────────┘

// ── PRIMARY SIGNAL: MAMA-FAMA adaptive cycle-confirmed spread ──
float mamaSpread = mama - fama

// Rescale to IFT input range using the cycle period
int rescaleLen = math.max(10, cyclePeriod * 2)
float rescaled  = f_rescale(mamaSpread, rescaleLen)

// Apply Inverse Fisher Transform for clean [-1, +1] bounding
float primarySignal = f_ift(rescaled * 0.5)

// ── MICROSTRUCTURE WEIGHTING ──

// Flow Weight: boost signal when VPIN-based flow aligns with direction
float flowAlignment = flowDir * (primarySignal > 0 ? 1.0 : -1.0)
float flowWeight    = i_vpin_enabled ? 1.0 + vpin * flowAlignment * 0.4 : 1.0

// Edge Weight: scale by Shannon edge quality
float edgeWeight = i_ent_enabled ? 0.5 + edgeQuality * 0.5 : 1.0

// Efficiency Weight: boost when price trends efficiently
float effWeight = 0.6 + er * 0.4

// ── FINAL PEP SCORE ──
float pepRaw = primarySignal * flowWeight * edgeWeight * effWeight
float pep    = math.max(-1.0, math.min(1.0, pepRaw))

// ── SIGNAL LINE ──
float pepSignal = ta.ema(pep, i_signal_smooth)

// ── HISTOGRAM ──
float hist     = pep - pepSignal
float histPrev = nz(hist[1])
bool  histUp   = hist > histPrev
bool  histPos  = hist >= 0


// ┌──────────────────────────────────────────────────────────────────────────────┐
// │                    SIGNAL GENERATION ENGINE                                  │
// └──────────────────────────────────────────────────────────────────────────────┘

// Step 1: Raw crossover detection
bool rawBuy  = ta.crossover(pep, pepSignal)
bool rawSell = ta.crossunder(pep, pepSignal)

// Step 2: Minimum zone filter (only from extremes)
bool zoneBuy  = rawBuy and pep < -i_min_zone
bool zoneSell = rawSell and pep > i_min_zone

// Step 3: Volume gate
bool volGatePass = not i_vol_gate or relativeVol >= 1.0

// Step 4: Edge quality gate (Shannon entropy filter)
bool edgePass = not i_edge_gate or edgeQuality >= i_edge_thresh

// Step 5: Histogram confirmation
bool histConfirmBuy  = hist > histPrev
bool histConfirmSell = hist < histPrev

// Step 6: Cooldown period
var int lastBuyBar  = -9999
var int lastSellBar = -9999
bool cooldownBuy  = i_cooldown == 0 or (bar_index - lastBuyBar) > i_cooldown
bool cooldownSell = i_cooldown == 0 or (bar_index - lastSellBar) > i_cooldown

// ── Final Filtered Signals ──
bool buySignal  = zoneBuy and volGatePass and edgePass and histConfirmBuy and cooldownBuy
bool sellSignal = zoneSell and volGatePass and edgePass and histConfirmSell and cooldownSell

// Strong signals: deep zone + VPIN alignment + high edge quality
bool strongBuy  = buySignal and pep < -(i_min_zone + 0.15) and (flowDir > 0 or stealthAccum) and edgeQuality > 0.4
bool strongSell = sellSignal and pep > (i_min_zone + 0.15) and (flowDir < 0 or stealthDistrib) and edgeQuality > 0.4

// Update cooldown trackers
if buySignal
    lastBuyBar := bar_index
if sellSignal
    lastSellBar := bar_index

// ── Confidence Scoring [0 to 100] ──
float confidence = 0.0
confidence += math.abs(pep) * 20.0                                           // Momentum magnitude
confidence += (i_vpin_enabled and flowAlignment > 0 ? vpin * 20.0 : 0.0)     // Flow alignment
confidence += edgeQuality * 20.0                                              // Edge quality
confidence += er * 15.0                                                       // Trending efficiency
confidence += (stealthAccum or stealthDistrib ? 10.0 : 0.0)                  // Institutional presence
confidence += (barsSinceBreak < 10 ? 10.0 : 0.0)                             // Recent regime change
confidence += (histUp == histPos ? 5.0 : 0.0)                                // Histogram momentum alignment
confidence := math.min(confidence, 100.0)

// ── Market State Classification ──
string marketState = ""
color  stateColor  = color.gray
if breakUp or breakDn
    marketState := "⚡ BREAK"
    stateColor  := breakUp ? color.new(i_bull_color, 0) : color.new(i_bear_color, 0)
else if mamaBull and er > 0.35
    marketState := "📈 TREND UP"
    stateColor  := color.new(i_bull_color, 0)
else if mamaBear and er > 0.35
    marketState := "📉 TREND DN"
    stateColor  := color.new(i_bear_color, 0)
else if er < 0.15
    marketState := "〰 RANGING"
    stateColor  := color.gray
else
    marketState := "🔄 TRANSITION"
    stateColor  := color.new(#FFD740, 0)


// ┌──────────────────────────────────────────────────────────────────────────────┐
// │                          VISUAL ENGINE                                      │
// └──────────────────────────────────────────────────────────────────────────────┘

// ── Color Palette ──
color bullFull = color.new(i_bull_color, 0)
color bullMid  = color.new(i_bull_color, 40)
color bullFade = color.new(i_bull_color, 75)
color bearFull = color.new(i_bear_color, 0)
color bearMid  = color.new(i_bear_color, 40)
color bearFade = color.new(i_bear_color, 75)

// ── Histogram: 4-State Color System ──
color histColor = histPos ? (histUp ? bullFull : bullMid) : (histUp ? bearMid : bearFull)

// ── Main Plots ──
plot(hist, title="Histogram", style=plot.style_columns, color=histColor, linewidth=2)

// PEP Line with glow effect
plot(pep, title="PEP Glow", color=color.new(i_pep_color, 70), linewidth=5, display=display.pane)
p_pep = plot(pep, title="PEP Line", color=color.new(i_pep_color, 0), linewidth=2)

// Signal Line
p_sig = plot(pepSignal, title="Signal Line", color=color.new(i_signal_color, 20), linewidth=1)

// Momentum Fill between PEP and Signal
fill(p_pep, p_sig, color=pep > pepSignal ? color.new(i_bull_color, 85) : color.new(i_bear_color, 85),
     title="Momentum Fill")

// Zero Line
h0 = hline(0, title="Zero", color=color.new(color.gray, 70), linestyle=hline.style_dotted, linewidth=1)

// Overbought / Oversold Zones
h_ob = hline(0.8, title="Overbought", color=color.new(i_bear_color, 85), linestyle=hline.style_dashed)
h_os = hline(-0.8, title="Oversold", color=color.new(i_bull_color, 85), linestyle=hline.style_dashed)
fill(h_ob, h0, color=color.new(i_bear_color, 95), title="OB Zone")
fill(h0, h_os, color=color.new(i_bull_color, 95), title="OS Zone")

// ── VPIN Toxicity Dots (on zero line) ──
plotshape(highToxicity ? 0 : na, title="High Toxicity", style=shape.diamond,
          location=location.absolute, color=color.new(#E040FB, 0), size=size.tiny,
          text="", textcolor=color.new(#E040FB, 0))

// ── CUSUM Structural Break Markers ──
plotshape(breakUp ? pep : na, title="Break Up", style=shape.triangleup,
          location=location.absolute, color=color.new(#76FF03, 0), size=size.small,
          text="BREAK", textcolor=color.new(#76FF03, 0))
plotshape(breakDn ? pep : na, title="Break Down", style=shape.triangledown,
          location=location.absolute, color=color.new(#FF6E40, 0), size=size.small,
          text="BREAK", textcolor=color.new(#FF6E40, 0))

// ── Signal Markers ──
plotshape(strongBuy ? pep : na, title="Strong Buy", style=shape.triangleup,
          location=location.absolute, color=color.new(i_bull_color, 0), size=size.small,
          text="BUY", textcolor=color.new(i_bull_color, 0))
plotshape(strongSell ? pep : na, title="Strong Sell", style=shape.triangledown,
          location=location.absolute, color=color.new(i_bear_color, 0), size=size.small,
          text="SELL", textcolor=color.new(i_bear_color, 0))

plotshape(buySignal and not strongBuy ? pep : na, title="Buy", style=shape.circle,
          location=location.absolute, color=color.new(i_bull_color, 30), size=size.tiny)
plotshape(sellSignal and not strongSell ? pep : na, title="Sell", style=shape.circle,
          location=location.absolute, color=color.new(i_bear_color, 30), size=size.tiny)

// ── Stealth Accumulation/Distribution Markers (on zero line) ──
plotshape(stealthAccum ? 0 : na, title="Stealth Accumulation", style=shape.cross,
          location=location.absolute, color=color.new(#00BFA5, 0), size=size.tiny)
plotshape(stealthDistrib ? 0 : na, title="Stealth Distribution", style=shape.cross,
          location=location.absolute, color=color.new(#FF6E40, 0), size=size.tiny)

// ── Flow Divergence Labels ──
plotshape(flowDivBull ? pep : na, title="Flow Div Bull", style=shape.labelup,
          location=location.absolute, color=color.new(#00BFA5, 10), size=size.tiny,
          text="FLOW↗", textcolor=color.white)
plotshape(flowDivBear ? pep : na, title="Flow Div Bear", style=shape.labeldown,
          location=location.absolute, color=color.new(#FF6E40, 10), size=size.tiny,
          text="FLOW↘", textcolor=color.white)

// ── Edge Quality Background ──
bgcolor(i_ent_enabled and edgeQuality > 0.55 ? color.new(#7C4DFF, 96) : na,
        title="High Edge Background")

// ── Regime Break Background flash ──
bgcolor(breakUp ? color.new(#76FF03, 90) : breakDn ? color.new(#FF6E40, 90) : na,
        title="Break Flash")

// ── Bar Coloring ──
barcolor(i_bar_color ? (pep > 0.3 ? bullFull : pep > 0 ? bullMid : pep > -0.3 ? bearMid : bearFull) : na,
         title="PEP Bar Color")


// ┌──────────────────────────────────────────────────────────────────────────────┐
// │                     LIVE INSTITUTIONAL DASHBOARD                             │
// └──────────────────────────────────────────────────────────────────────────────┘

if i_show_table and barstate.islast
    var table dash = table.new(position.top_right, 2, 14,
                               bgcolor=color.new(#0D1117, 5),
                               border_color=color.new(#30363D, 0),
                               border_width=1,
                               frame_color=color.new(#7C4DFF, 30),
                               frame_width=2)

    // Row 0: Header
    table.cell(dash, 0, 0, "  PHANTOM EDGE PROTOCOL  ",
               text_color=color.new(#7C4DFF, 0), text_size=size.small,
               bgcolor=color.new(#161B22, 0), text_halign=text.align_center)
    table.merge_cells(dash, 0, 0, 1, 0)

    // Row 1: PEP Value
    color pepDashColor = pep > 0 ? bullFull : bearFull
    table.cell(dash, 0, 1, "PEP Score", text_color=color.new(#8B949E, 0),
               text_size=size.tiny, bgcolor=color.new(#0D1117, 0))
    table.cell(dash, 1, 1, str.tostring(pep, "#.####"), text_color=pepDashColor,
               text_size=size.tiny, bgcolor=color.new(#0D1117, 0))

    // Row 2: Signal
    table.cell(dash, 0, 2, "Signal", text_color=color.new(#8B949E, 0),
               text_size=size.tiny, bgcolor=color.new(#0D1117, 0))
    table.cell(dash, 1, 2, str.tostring(pepSignal, "#.####"), text_color=color.new(i_signal_color, 0),
               text_size=size.tiny, bgcolor=color.new(#0D1117, 0))

    // Row 3: Histogram
    table.cell(dash, 0, 3, "Histogram", text_color=color.new(#8B949E, 0),
               text_size=size.tiny, bgcolor=color.new(#0D1117, 0))
    table.cell(dash, 1, 3, str.tostring(hist, "#.####"), text_color=histColor,
               text_size=size.tiny, bgcolor=color.new(#0D1117, 0))

    // Row 4: Dominant Cycle Period (UNIQUE — no retail indicator shows this)
    table.cell(dash, 0, 4, "🔬 Cycle", text_color=color.new(#8B949E, 0),
               text_size=size.tiny, bgcolor=color.new(#0D1117, 0))
    table.cell(dash, 1, 4, str.tostring(cyclePeriod) + " bars", text_color=color.new(#7C4DFF, 0),
               text_size=size.tiny, bgcolor=color.new(#0D1117, 0))

    // Row 5: VPIN Toxicity
    string toxStr = i_vpin_enabled ? str.tostring(toxicity, "#.##") + "σ" : "OFF"
    color toxColor = highToxicity ? color.new(#E040FB, 0) : toxicity > 0.5 ? color.new(#FFD740, 0) : color.new(#8B949E, 0)
    table.cell(dash, 0, 5, "🧬 Toxicity", text_color=color.new(#8B949E, 0),
               text_size=size.tiny, bgcolor=color.new(#0D1117, 0))
    table.cell(dash, 1, 5, toxStr, text_color=i_vpin_enabled ? toxColor : color.gray,
               text_size=size.tiny, bgcolor=color.new(#0D1117, 0))

    // Row 6: Edge Quality
    string edgeStr = i_ent_enabled ? str.tostring(edgeQuality * 100.0, "#") + "%" : "OFF"
    color edgeColor = edgeQuality > 0.5 ? bullFull : edgeQuality > 0.35 ? color.new(#FFD740, 0) : bearFull
    table.cell(dash, 0, 6, "🧪 Edge", text_color=color.new(#8B949E, 0),
               text_size=size.tiny, bgcolor=color.new(#0D1117, 0))
    table.cell(dash, 1, 6, edgeStr, text_color=i_ent_enabled ? edgeColor : color.gray,
               text_size=size.tiny, bgcolor=color.new(#0D1117, 0))

    // Row 7: Kyle's Lambda
    string lamStr = i_lam_enabled ? str.tostring(lambdaZ, "#.##") + "σ" : "OFF"
    color lamColor = lambdaZ < -1.0 ? color.new(#E040FB, 0) : lambdaZ > 1.0 ? color.new(#FF6E40, 0) : color.new(#8B949E, 0)
    table.cell(dash, 0, 7, "🕵 Lambda", text_color=color.new(#8B949E, 0),
               text_size=size.tiny, bgcolor=color.new(#0D1117, 0))
    table.cell(dash, 1, 7, lamStr, text_color=i_lam_enabled ? lamColor : color.gray,
               text_size=size.tiny, bgcolor=color.new(#0D1117, 0))

    // Row 8: Efficiency Ratio
    string erStr = str.tostring(er * 100.0, "#") + "%"
    color erColor = er > 0.5 ? bullFull : er > 0.25 ? color.new(#FFD740, 0) : color.new(#8B949E, 0)
    table.cell(dash, 0, 8, "📐 Efficiency", text_color=color.new(#8B949E, 0),
               text_size=size.tiny, bgcolor=color.new(#0D1117, 0))
    table.cell(dash, 1, 8, erStr, text_color=erColor,
               text_size=size.tiny, bgcolor=color.new(#0D1117, 0))

    // Row 9: Market State
    table.cell(dash, 0, 9, "State", text_color=color.new(#8B949E, 0),
               text_size=size.tiny, bgcolor=color.new(#0D1117, 0))
    table.cell(dash, 1, 9, marketState, text_color=stateColor,
               text_size=size.tiny, bgcolor=color.new(#0D1117, 0))

    // Row 10: CUSUM Status
    string cusumStr = barsSinceBreak < 5 ? "⚡ " + str.tostring(barsSinceBreak) + " bars ago" : "— " + str.tostring(barsSinceBreak) + " bars"
    color cusumColor = barsSinceBreak < 5 ? (lastBreakDir ? bullFull : bearFull) : color.new(#8B949E, 0)
    table.cell(dash, 0, 10, "⚡ Break", text_color=color.new(#8B949E, 0),
               text_size=size.tiny, bgcolor=color.new(#0D1117, 0))
    table.cell(dash, 1, 10, cusumStr, text_color=cusumColor,
               text_size=size.tiny, bgcolor=color.new(#0D1117, 0))

    // Row 11: Confidence
    string confStr = str.tostring(confidence, "#") + "%"
    color confColor = confidence > 70 ? bullFull : confidence > 40 ? color.new(#FFD740, 0) : bearFull
    table.cell(dash, 0, 11, "Confidence", text_color=color.new(#8B949E, 0),
               text_size=size.tiny, bgcolor=color.new(#0D1117, 0))
    table.cell(dash, 1, 11, confStr, text_color=confColor,
               text_size=size.tiny, bgcolor=color.new(#0D1117, 0))

    // Row 12: Stealth Detection
    string stealthStr = stealthAccum ? "🟢 ACCUMULATION" : stealthDistrib ? "🔴 DISTRIBUTION" : "— NONE"
    color stealthColor = stealthAccum ? color.new(#00BFA5, 0) : stealthDistrib ? color.new(#FF6E40, 0) : color.new(#8B949E, 0)
    table.cell(dash, 0, 12, "🕵 Stealth", text_color=color.new(#8B949E, 0),
               text_size=size.tiny, bgcolor=color.new(#0D1117, 0))
    table.cell(dash, 1, 12, stealthStr, text_color=stealthColor,
               text_size=size.tiny, bgcolor=color.new(#0D1117, 0))

    // Row 13: Adaptive Status
    string adaptStr = i_adaptive ? "🔄 CYCLE: " + str.tostring(cyclePeriod) : "📌 FIXED"
    color adaptColor = i_adaptive ? color.new(#7C4DFF, 0) : color.new(#8B949E, 0)
    table.cell(dash, 0, 13, "Lookback", text_color=color.new(#8B949E, 0),
               text_size=size.tiny, bgcolor=color.new(#0D1117, 0))
    table.cell(dash, 1, 13, adaptStr, text_color=adaptColor,
               text_size=size.tiny, bgcolor=color.new(#0D1117, 0))


// ┌──────────────────────────────────────────────────────────────────────────────┐
// │                            ALERTS                                           │
// └──────────────────────────────────────────────────────────────────────────────┘

alertcondition(strongBuy, title="⚡ Strong BUY Signal",
     message="PEP STRONG BUY — Cycle-confirmed + flow-aligned + high edge quality reversal from oversold.")
alertcondition(strongSell, title="⚡ Strong SELL Signal",
     message="PEP STRONG SELL — Cycle-confirmed + flow-aligned + high edge quality reversal from overbought.")
alertcondition(buySignal, title="📗 Buy Signal",
     message="PEP Buy — MAMA cycle crossover confirmed with microstructure intelligence.")
alertcondition(sellSignal, title="📕 Sell Signal",
     message="PEP Sell — MAMA cycle crossover confirmed with microstructure intelligence.")
alertcondition(breakUp, title="⚡ Structural Break UP",
     message="PEP CUSUM BREAK UP — New bullish regime detected! Structural change in market dynamics.")
alertcondition(breakDn, title="⚡ Structural Break DOWN",
     message="PEP CUSUM BREAK DOWN — New bearish regime detected! Structural change in market dynamics.")
alertcondition(highToxicity, title="🧬 High Flow Toxicity",
     message="PEP HIGH TOXICITY — VPIN indicates informed traders are highly active. Current move has institutional backing.")
alertcondition(stealthAccum, title="🕵 Stealth Accumulation",
     message="PEP STEALTH ACCUMULATION — Kyle's Lambda dropping while volume rises with bullish bias. Institutions absorbing without moving price.")
alertcondition(stealthDistrib, title="🕵 Stealth Distribution",
     message="PEP STEALTH DISTRIBUTION — Kyle's Lambda dropping while volume rises with bearish bias. Institutions distributing without moving price.")
alertcondition(flowDivBull, title="🔄 Bullish Flow Divergence",
     message="PEP FLOW DIVERGENCE — High VPIN with buy-side flow opposing downtrend. Smart money positioning for reversal UP.")
alertcondition(flowDivBear, title="🔄 Bearish Flow Divergence",
     message="PEP FLOW DIVERGENCE — High VPIN with sell-side flow opposing uptrend. Smart money positioning for reversal DOWN.")

// ── END ──
