// sell2    = c_rng2 > 0 ? volume * (high - close) / c_rng2 : volume * 0.5
// in_s2    = not na(time(timeframe.period, "0930-1600"))
// s_open2  = in_s2 and not in_s2[1]
// var float cd2 = 0.0
// cd2     := s_open2 ? buy2 - sell2 : cd2 + (buy2 - sell2)
// plot(cd2,  "Cumulative Delta", color = cd2 >= 0 ? #00E676 : #FF1744, style = plot.style_histogram, linewidth = 2)
// plot(0,    "Zero Line",        color = color.new(color.white, 60))
// ─────────────────────────────────────────────────────────────────────────────
